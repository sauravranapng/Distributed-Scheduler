# I am keeping it for other developers to use as a template.
SPRING_PROFILE=local
JAVA_OPTS=-Xms128m -Xmx256m
KAFKA_CLUSTER_ID=YOUR_CLUSTER_ID
JOB_SERVICE_PORT=8084
SCHEDULING_SERVICE_PORT=8082
EXECUTOR_SERVICE_PORT=8083
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
ZOOKEEPER_PORT=2181

# Astra DB credentials: keep the real values only in your untracked .env file.
ASTRA_USERNAME=replace-with-your-astra-username
ASTRA_PASSWORD=replace-with-your-astra-password
